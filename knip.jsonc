{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Keep the configuration itself free of redundant or stale patterns.
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    "apps/deskohub-workspace": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "**/*.pw.ts",
        "**/*.typecheck.ts",
        "**/*.rsc-fixture.ts",
        "**/*-rsc-fixture.ts",
        "**/*.browser-harness.{ts,tsx}",
        "**/drizzle.config.ts",
        "playwright.*.config.ts",
        // drizzle.config.ts files load their schema by path, not by import,
        // and drizzle-kit reads every export of these modules.
        "db/schema/index.ts",
        "db/schema/auth.ts",
        "e2e/coordination/schema.ts",
        "env.ts",
        // Public reusable-email service API during the additive rollout, before delivery switches.
        "features/emails/backend/index.ts",
        // Public customer-value resolver consumed by recipient preparation.
        "features/emails/values/customer/index.ts",
        // Public discount-value issuance consumed by recipient preparation and delivery cleanup.
        "features/emails/values/discount/index.ts",
        // Public recipient preparation and samples consumed by delivery and previews.
        "features/emails/values/preparation/index.ts",
        // Command-line scripts run by path from package.json, CI, or the skills.
        "scripts/*.ts",
        "scripts/account-sticky/run.ts",
        "scripts/discounts-admin-dates/run.ts",
        // Loaded by path: bundled renderer entries and child-process fixtures.
        "scripts/account-sticky/browser-entry.tsx",
        "scripts/shared/command.*-fixture.{ts,mjs}",
        "e2e/coordination/hosted-payment-permit.holder-fixture.ts",
        "shared/backend/workspace-location-map.render-fixture.ts",
        "e2e/agent-evals/harness.stub-fixture.ts",
        // Bundled by path from the booking view's index.html.
        "features/agent-tools/booking-widget/booking-widget.tsx",
        // Bundled by path into the Temporal polyfill and its <head> loader.
        "shared/polyfills/*.browser.ts",
        // Bundled by path for browser-rendered test fixtures.
        "shared/testing/posthog-identity-browser-fixture.tsx",
        "types/*.d.ts"
      ],
      // drizzle.config.ts decodes DATABASE_URL at module load, so the plugin cannot
      // load it; drizzle-kit stays verified via binaries from the db:* scripts.
      "drizzle": false,
      "ignoreDependencies": [
        // Registry name served by the @effect/tsgo-patched native TypeScript
        // (`prepare` script), not an installable module.
        "@effect/language-service",
        // Preview server the `email:dev` CLI resolves from the project at runtime.
        "@react-email/ui",
        // Not imported: declared so Vercel deploys Workspace previews for
        // agent-skill changes (apps/deskohub-portal/deployment-graph.test.ts).
        "@deskohub/agent-skills",
        // Not imported: `mobile-web-app:build` copies its web export to
        // public/app, so its changes must deploy the Workspace too.
        "deskohub-mobile"
      ]
    },
    "apps/deskohub-mobile": {
      // app.config.ts derives the Android version code from the version that
      // Expo merges in from app.json; the plugin loads it without that merge,
      // so it reads the static app.json instead.
      "expo": { "config": ["app.json"] }
    }
  }
}
