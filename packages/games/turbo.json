{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate"]
    }
  }
}
