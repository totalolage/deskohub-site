{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "posthog-openapi.json.gz",
        "posthog-openapi.json.gz.sha256",
        "scripts/generate.ts"
      ],
      "outputs": ["src/generated/**"]
    },
    "generated:check": {
      "inputs": [
        "scripts/check-generated.ts",
        "posthog-openapi.json.gz",
        "posthog-openapi.json.gz.sha256",
        "src/generated/effect.gen.ts",
        "src/generated/effect.gen.sha256"
      ]
    },
    "typecheck": {
      "dependsOn": ["generated:check"]
    }
  }
}
