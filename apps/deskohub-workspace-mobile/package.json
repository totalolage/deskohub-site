{
  "name": "deskohub-workspace-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "bun scripts/prepare-web-public.ts && expo export --platform web --clear",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "build:android": "bash scripts/build-android-release.sh",
    "assets:generate": "bun scripts/generate-brand-assets.ts",
    "lint": "cd ../.. && biome check apps/deskohub-workspace-mobile/app apps/deskohub-workspace-mobile/components apps/deskohub-workspace-mobile/constants apps/deskohub-workspace-mobile/src apps/deskohub-workspace-mobile/plugins apps/deskohub-workspace-mobile/scripts apps/deskohub-workspace-mobile/app.config.ts --config-path biome.json --vcs-root .",
    "test": "bun test src plugins",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deskohub/app-updater": "file:./modules/app-updater",
    "@deskohub/i18n": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~57.0.12",
    "expo-application": "~57.0.2",
    "expo-background-task": "~57.0.9",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.9",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.6.0",
    "eslint-config-expo": "~57.0.1",
    "jest-expo": "~57.0.4",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  }
}
