{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "extends": ["\/\/"],
  "tasks": {
    "build": {
      "dependsOn": ["i18n:compile"],
      "outputs": ["dist/**", ".astro/**", ".vercel/output/**"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "i18n:compile"],
      // The deployment tests read the repository's package graph.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.agents/package.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "i18n:compile"]
    },
    "i18n:compile": {
      "inputs": [
        "features/i18n/messages/*.json",
        "project.inlang/settings.json",
        "project.inlang/project_id"
      ],
      "outputs": ["features/i18n/paraglide/**"]
    },
    "dev:site": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
