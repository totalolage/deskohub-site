{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "lint:biome", "lint:eslint", "lint:knip"]
    },
    "lint:biome": {
      "inputs": ["$TURBO_DEFAULT$", "../../biome.json", "../../lint/*.grit"]
    },
    "lint:eslint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint:knip": {
      "dependsOn": [
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../knip.jsonc",
        "../../package.json",
        "package.json"
      ]
    },
    "build:compile": {
      "cache": false,
      "dependsOn": [
        "^build",
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build",
        "mobile-web-app:build",
        "feature-flags:snapshot"
      ],
      "passThroughEnv": ["BETTER_AUTH_SECRETS", "REVIEW_ACCOUNT_CREDENTIALS"]
    },
    "build:source-maps": {
      "cache": false,
      "dependsOn": ["build:compile"]
    },
    "build:generate": {
      "cache": false,
      "dependsOn": ["build:source-maps"],
      "passThroughEnv": ["BETTER_AUTH_SECRETS", "REVIEW_ACCOUNT_CREDENTIALS"]
    },
    "build": {
      "cache": false,
      "dependsOn": ["build:generate"]
    },
    "i18n:compile": {
      "dependsOn": ["i18n:compile:administration"],
      "env": ["!NEXT_PUBLIC_VERCEL_*"],
      "inputs": [
        "features/i18n/messages/*.json",
        "project.inlang/settings.json",
        "project.inlang/project_id",
        "package.json"
      ],
      "outputs": ["features/i18n/paraglide/**"]
    },
    "i18n:compile:administration": {
      "env": ["!NEXT_PUBLIC_VERCEL_*"],
      "inputs": [
        "features/administration/i18n/messages/**/*.json",
        "features/administration/i18n/project.inlang/settings.json",
        "package.json"
      ],
      "outputs": ["features/administration/i18n/paraglide/**"]
    },
    "feature-flags:sync": {
      "cache": false,
      "env": ["POSTHOG_API_HOST", "POSTHOG_API_KEY", "POSTHOG_PROJECT_ID"],
      "outputs": [
        "features/feature-flags/generated/contract.ts",
        "features/feature-flags/generated/flag-snapshot.ts"
      ]
    },
    "feature-flags:snapshot": {
      "cache": false,
      "env": [
        "POSTHOG_API_HOST",
        "POSTHOG_API_KEY",
        "POSTHOG_PROJECT_ID",
        "VERCEL"
      ],
      "outputs": ["features/feature-flags/generated/flag-snapshot.ts"]
    },
    "db:generate": {
      "cache": false,
      "dependsOn": ["i18n:compile"],
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "dev": {
      "dependsOn": [
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ],
      "passThroughEnv": ["WORKSPACE_TEST_DATABASE_URL"]
    },
    "test:dependencies": {
      "dependsOn": [
        "@deskohub/agent-skills#test",
        "@deskohub/ares#test",
        "@deskohub/brand-tokens#test",
        "@deskohub/cloudinary#test",
        "@deskohub/cloudinary-image#test",
        "@deskohub/dotypos#test",
        "@deskohub/effect-schema-resolver#test",
        "@deskohub/email#test",
        "@deskohub/google-calendar#test",
        "@deskohub/i18n#test",
        "@deskohub/igloohome#test",
        "@deskohub/nexi#test",
        "@deskohub/next-effect#test",
        "@deskohub/phone-number#test",
        "@deskohub/posthog#test",
        "@deskohub/qr-code#test",
        "@deskohub/secret-comparison#test",
        "@deskohub/standard-schema#test",
        "@deskohub/test-email#test",
        "@deskohub/workspace-admin-api#test",
        "@deskohub/workspace-customer-api#test",
        "osm#test"
      ],
      "inputs": []
    },
    "test:shard-1": {
      "dependsOn": [
        "test:dependencies",
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ],
      "env": ["CI", "TZ"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test-timings.shard-*.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/lint/*.grit",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/{.agents,apps/*,packages/*}/package.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/app.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/public/**",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/{apps,packages}/*/.gitignore",
        "!$TURBO_ROOT$/**/node_modules/**"
      ],
      "outputs": ["test-timings.shard-1.json"],
      "passThroughEnv": [
        "WORKSPACE_TEST_DATABASE_URL",
        "WORKSPACE_TEST_DATABASE_URL_SHARD_1"
      ]
    },
    "test:shard-2": {
      "dependsOn": [
        "test:dependencies",
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ],
      "env": ["CI", "TZ"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test-timings.shard-*.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/lint/*.grit",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/{.agents,apps/*,packages/*}/package.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/app.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/public/**",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/{apps,packages}/*/.gitignore",
        "!$TURBO_ROOT$/**/node_modules/**"
      ],
      "outputs": ["test-timings.shard-2.json"],
      "passThroughEnv": [
        "WORKSPACE_TEST_DATABASE_URL",
        "WORKSPACE_TEST_DATABASE_URL_SHARD_2"
      ]
    },
    "test:shard-3": {
      "dependsOn": [
        "test:dependencies",
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ],
      "env": ["CI", "TZ"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test-timings.shard-*.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/lint/*.grit",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/{.agents,apps/*,packages/*}/package.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/app.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/public/**",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/{apps,packages}/*/.gitignore",
        "!$TURBO_ROOT$/**/node_modules/**"
      ],
      "outputs": ["test-timings.shard-3.json"],
      "passThroughEnv": [
        "WORKSPACE_TEST_DATABASE_URL",
        "WORKSPACE_TEST_DATABASE_URL_SHARD_3"
      ]
    },
    "test:shard-4": {
      "dependsOn": [
        "test:dependencies",
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "booking-widget:build",
        "temporal-polyfill:build"
      ],
      "env": ["CI", "TZ"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test-timings.shard-*.json",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/lint/*.grit",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/{.agents,apps/*,packages/*}/package.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/app.json",
        "$TURBO_ROOT$/apps/deskohub-mobile/public/**",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/{apps,packages}/*/.gitignore",
        "!$TURBO_ROOT$/**/node_modules/**"
      ],
      "outputs": ["test-timings.shard-4.json"],
      "passThroughEnv": [
        "WORKSPACE_TEST_DATABASE_URL",
        "WORKSPACE_TEST_DATABASE_URL_SHARD_4"
      ]
    },
    "test:e2e": {
      "dependsOn": ["$TURBO_EXTENDS$", "@deskohub/igloohome#generate"]
    },
    "test:admin-cli": {
      "cache": false,
      "dependsOn": [
        "@deskohub/dotypos#generate",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile"
      ],
      "passThroughEnv": ["WORKSPACE_TEST_DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@deskohub/igloohome#generate",
        "@deskohub/nexi#generate",
        "i18n:compile",
        "temporal-polyfill:build",
        "typegen"
      ]
    },
    "typegen": {
      "outputs": [".next/types/**"]
    },
    "booking-widget:build": {
      "dependsOn": ["i18n:compile"],
      "env": ["!NEXT_PUBLIC_VERCEL_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!**/*.test-utils.ts",
        "!e2e/**",
        "!**/generated/**"
      ],
      "outputs": ["features/agent-tools/booking-widget/generated/**"]
    },
    "mobile-web-app:build": {
      "dependsOn": ["deskohub-mobile#build:web"],
      "inputs": [
        "features/mobile-web-app/*.{js,ts}",
        "!features/mobile-web-app/*.test.ts"
      ],
      "outputs": ["public/app/**"]
    },
    "temporal-polyfill:build": {
      "env": ["!NEXT_PUBLIC_VERCEL_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.{ts,tsx}",
        "!**/*.test-utils.ts",
        "!e2e/**",
        "!**/generated/**",
        "!public/polyfills/**",
        "$TURBO_ROOT$/packages/workspace-admin-api/src/site-time-zone.ts"
      ],
      "outputs": ["public/polyfills/**", "shared/polyfills/generated/**"]
    }
  }
}
