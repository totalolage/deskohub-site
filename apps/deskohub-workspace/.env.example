# Workspace app env example
# Copy to apps/deskohub-workspace/.env.local for shared app defaults.
# Use apps/deskohub-workspace/.env.development.local for developer-only overrides.

# Database
# User-provided Postgres connection string. No database exists yet; provision one,
# set this value, then generate/apply fresh Drizzle migrations from db/schema.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local development screenshots only; this cannot activate in deployed builds.
# ADMIN_PREVIEW_FIXTURES=true

# Nexi payment API
NEXI_API_ORIGIN=https://xpaysandbox.nexigroup.com
NEXI_API_KEY=replace_me

# Checkout return-state token hashing pepper. Generate at least 32 random chars.
CHECKOUT_RETURN_STATE_TOKEN_SECRET=replace_with_32_plus_random_characters

# Long-lived reservation-access link secret. Keep it available for at least the
# maximum future reservation lifetime. Generate at least 32 random characters.
RESERVATION_ACCESS_TOKEN_SECRET=replace_with_32_plus_random_characters

# Vercel callback URL discovery
# Vercel provides these automatically on deployments. These local values are
# deployment stand-ins only; local Nexi HPP callbacks need a real HTTPS URL
# reachable by Nexi, or use a Vercel preview deployment.
VERCEL_ENV=development
VERCEL_URL=localhost:3000
VERCEL_PROJECT_PRODUCTION_URL=workspace.deskohub.cz

# Dotypos API
# Workspace reservation fulfillment selects an active visible Dotypos table by
# table tags. Configure tables with tier tags (`tier:basic`, `tier:plus`,
# `tier:profi`) and Profi monitor tags (`monitor:count:2`, `monitor:size:27|32`,
# `monitor:resolution:qhd|4k`).
DOTYPOS_API_URL=https://api.dotykacka.cz
DOTYPOS_API_TIMEOUT=30000
DOTYPOS_CLIENT_ID=replace_me
DOTYPOS_CLIENT_SECRET=replace_me
DOTYPOS_REFRESH_TOKEN=replace_me
DOTYPOS_CLOUD_ID=replace_me
DOTYPOS_BRANCH_ID=replace_me
DOTYPOS_EMPLOYEE_ID=replace_me

# PostHog Custom REST source for Dotypos customers (production only; other
# environments keep the source disabled). Generate at least 32 random chars.
# ANALYTICS_WAREHOUSE_SOURCE_TOKEN=

# Igloohome AlgoPIN provisioning (production only; other environments use fixtures)
IGLOOHOME_CLIENT_ID=replace_me
IGLOOHOME_CLIENT_SECRET=replace_me
IGLOOHOME_ALGOPIN_TARGET_DEVICE_ID=replace_with_ek1_device_id

# Google Calendar resources
# Calendar event descriptions containing [workspace:full] block reservations.
# Descriptions containing [workspace:partial] show a non-blocking notice.
GOOGLE_CALENDAR_WORKSPACE_LIMITATIONS_ID=replace_me
# Dedicated calendar containing [deskohub:sale] events.
GOOGLE_CALENDAR_SALES_ID=replace_me
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=replace_me@example.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Email service
# Mail addressed only to @deskohub.test test recipients (EMAIL_TEST_DOMAIN in
# @deskohub/test-email) is logged by Console and never sent; all other mail,
# including Resend's resend.dev simulator, goes to Resend. EMAIL_API_KEY is
# required in production and preview; without it in development every message
# is logged by Console. Synthetic Preview magic links also emit one authorized
# runtime log line, and under `next dev` every magic link Console accepts is
# printed as one `account.magic-link.development` line so local sign-in works.
EMAIL_API_KEY=replace_me
EMAIL_FROM_NAME=Deskohub Workspace
# Admin email campaigns. Production requires all three; elsewhere unset
# values fall back to @deskohub.test addresses, whose mail stays on Console.
# EMAIL_CAMPAIGN_FROM=
# EMAIL_CAMPAIGN_REPLY_TO=
# EMAIL_CAMPAIGN_ADMIN_INBOX=
# Resend webhook signing secret for delivery callbacks. Required and non-empty.
RESEND_WEBHOOK_SECRET=replace_me

# WORKSPACE_E2E_VERCEL_TOKEN belongs only in the workspace-checkout-e2e GitHub
# environment; never set it in Vercel or application configuration.

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Client analytics/runtime flags
NEXT_PUBLIC_GTM_ID=GTM-T9MB5LF3
NEXT_PUBLIC_POSTHOG_HOST=https://t.workspace.deskohub.cz
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replace_me
POSTHOG_SERVICE_NAME=deskohub-workspace
POSTHOG_SERVICE_NAMESPACE=deskohub

# Customer accounts (Better Auth)
# Versioned rotating secrets (`version:base64url-secret`), at least 48 random
# bytes per version. Required in production: environment validation fails
# closed unless a valid versioned value is configured. Development and preview
# may omit it; a local production build needs a development-only synthetic
# value.
BETTER_AUTH_SECRETS=replace_with_1_replace_with_48_random_base64url_characters

# Shared PostHog project configuration.
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_INGEST_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=replace_me
# Personal API key with error_tracking:write, feature_flag:read, and query:read.
POSTHOG_API_KEY=replace_me
