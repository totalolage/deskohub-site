# Workspace app env example
# Copy to apps/deskohub-workspace/.env.local for shared app defaults.
# Use apps/deskohub-workspace/.env.development.local for developer-only overrides.

# Database
# User-provided Postgres connection string. No database exists yet; provision one,
# set this value, then generate/apply fresh Drizzle migrations from db/schema.
DATABASE_URL=

# SHA-256 of the complete HTTP Basic credential string `username:password`.
# Generate it without storing the cleartext credential in application config.
ADMIN_BASIC_AUTH_SHA256=

# Nexi payment API
NEXI_API_ORIGIN=
NEXI_API_KEY=

# Checkout return-state token hashing pepper. Generate at least 32 random chars.
CHECKOUT_RETURN_STATE_TOKEN_SECRET=

# Checkout encrypted Pay-state key ring. Keep the exact bytes and entry order
# unchanged throughout the reservation-HMAC bridge and legacy-read window.
CHECKOUT_PAY_STATE_KEYS=

# Reservation/session HMAC bridge. Leave the schedule fields unset during the
# raw-write bridge deployment. See docs/checkout-lifecycle.md before scheduling
# a cutover; never place secret material in documentation or source control.
CHECKOUT_RESERVATION_HMAC_SECRET=
CHECKOUT_RESERVATION_HMAC_CUTOVER_AT=
CHECKOUT_RESERVATION_HMAC_LEGACY_READ_UNTIL=

# Vercel callback URL discovery
# Vercel provides these automatically on deployments. These local values are
# deployment stand-ins only; local Nexi HPP callbacks need a real HTTPS URL
# reachable by Nexi, or use a Vercel preview deployment.
VERCEL_ENV=
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Dotypos API
# Workspace reservation fulfillment selects an active visible Dotypos table by
# table tags. Configure tables with tier tags (`tier:basic`, `tier:plus`,
# `tier:profi`) and Profi monitor tags (`monitor:count:2`, `monitor:size:27|32`,
# `monitor:resolution:qhd|4k`).
DOTYPOS_API_URL=
DOTYPOS_API_TIMEOUT=
DOTYPOS_CLIENT_ID=
DOTYPOS_CLIENT_SECRET=
DOTYPOS_REFRESH_TOKEN=
DOTYPOS_CLOUD_ID=
DOTYPOS_BRANCH_ID=
DOTYPOS_EMPLOYEE_ID=

# Google Calendar resources
# Calendar event descriptions containing [workspace:full] block reservations.
# Descriptions containing [workspace:partial] show a non-blocking notice.
GOOGLE_CALENDAR_WORKSPACE_LIMITATIONS_ID=
# Dedicated calendar containing [deskohub:sale] events.
GOOGLE_CALENDAR_SALES_ID=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# Email service
# Workspace supports resend for delivered email and console for local/dev output.
# Production/preview should use Resend for live contact/manual reservations.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_NAME=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client analytics/runtime flags
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
POSTHOG_SERVICE_NAME=
POSTHOG_SERVICE_NAMESPACE=

# PostHog source map upload, only needed in Vercel/CI production builds.
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
