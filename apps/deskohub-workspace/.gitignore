.next/
e2e-artifacts/
node_modules/
.vercel
.env*.local
.env*
# Inlang writes its cache and metadata next to the settings when compiling.
# Its self-written .gitignore is itself ignored, and Turbo doesn't apply it,
# so without these lines a compile changes every Workspace task hash.
/project.inlang/*
!/project.inlang/settings.json
!/project.inlang/project_id
/features/administration/i18n/project.inlang/*
!/features/administration/i18n/project.inlang/settings.json
# Generated by i18n:compile; a Turbo cache restore omits its own .gitignore.
features/i18n/paraglide/
features/administration/i18n/paraglide/
# Generated by booking-widget:build.
features/agent-tools/booking-widget/generated/
# Generated by temporal-polyfill:build.
public/polyfills/
shared/polyfills/generated/
# Generated by mobile-web-app:build from the deskohub-mobile web export.
public/app/
# Written by each test:shard-N task; CI uploads it, the committed test-timings.json stays as is.
test-timings.shard-*.json
