{
  "name": "deskohub-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:generate": "MIMALLOC_PURGE_DELAY=0 next build --turbo --experimental-build-mode=generate",
    "build:compile": "MIMALLOC_PURGE_DELAY=0 next build --turbo --experimental-build-mode=compile",
    "build:source-maps": "bun scripts/upload-source-maps.ts",
    "vercel-build": "turbo build",
    "booking-widget:build": "bun features/agent-tools/booking-widget/build-booking-widget.ts",
    "dev": "bun --parallel dev:next dev:i18n dev:i18n:administration dev:booking-widget",
    "dev:booking-widget": "chokidar \"features/agent-tools/**/*.{ts,tsx,css,html}\" \"features/i18n/paraglide/messages/*.js\" \"shared/styles/*.css\" \"shared/components/ui/*.tsx\" -i \"**/generated/**\" -i \"**/*.test.{ts,tsx}\" -c \"bun booking-widget:build\"",
    "dev:next": "next dev --turbo",
    "dev:i18n": "chokidar \"features/i18n/messages/*.json\" -c \"bun i18n:compile\"",
    "dev:i18n:administration": "chokidar \"features/administration/i18n/messages/**/*.json\" -c \"bun i18n:compile:administration\"",
    "email:dev": "email dev --dir emails --port 3001",
    "i18n:compile": "bun x @inlang/paraglide-js compile --project ./project.inlang --outdir ./features/i18n/paraglide --output-structure locale-modules",
    "i18n:compile:administration": "bun x @inlang/paraglide-js compile --project ./features/administration/i18n/project.inlang --outdir ./features/administration/i18n/paraglide --output-structure locale-modules",
    "feature-flags:sync": "bun scripts/sync-posthog-feature-flags.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "e2e:capacity": "bun scripts/workspace-e2e-capacity.ts",
    "e2e:account-state": "bun scripts/workspace-e2e-account-state.ts",
    "e2e:cleanup-stale": "bun scripts/workspace-e2e-stale-cleanup.ts",
    "e2e:coordination:build-action": "bun build scripts/workspace-e2e-allocation.ts --target=node --format=esm --outfile=../../.github/actions/workspace-e2e-allocation/index.mjs",
    "e2e:coordination:generate": "drizzle-kit generate --config e2e/coordination/drizzle.config.ts",
    "e2e:coordination:provision": "drizzle-kit migrate --config e2e/coordination/drizzle.config.ts && bun scripts/workspace-e2e-coordination-provision.ts",
    "test:e2e": "bun scripts/workspace-e2e.ts",
    "lint:biome": "biome check app db emails features scripts shared *.ts --config-path \"$(git rev-parse --show-toplevel)/biome.json\"",
    "lint:eslint": "eslint --ext .ts,.tsx app db emails features scripts shared proxy.ts",
    "lint:knip": "knip --directory ../.. --workspace apps/deskohub-workspace",
    "test": "bun test --preload ./shared/testing/workspace-test-env.ts --parallel=1 --timeout 30000 --timings=./test-timings.json --path-ignore-patterns='**/*.build.test.ts'",
    "test:build-output": "bun test ./features/administration/i18n/administration-messages.build.test.ts",
    "test:admin-cli": "bun test --preload ./shared/testing/workspace-test-env.ts --parallel=1 features/admin-cli/workspace-admin-api.server.test.ts features/admin-cli/email-campaigns-api.server.test.ts features/admin-cli/email-automations-api.server.test.ts features/admin-cli/administrators-api.server.test.ts features/admin-cli/administrators-api.server.postgres.test.ts features/admin-cli/cli-client-version.server.test.ts features/admin-cli/administration-action-record.server.test.ts",
    "test:instant-navigation": "playwright test --config playwright.instant-navigation.config.ts",
    "test:accessibility": "playwright test --config playwright.accessibility.config.ts",
    "test:agent-evals": "playwright test --config playwright.agent-evals.config.ts",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "start": "next start"
  },
