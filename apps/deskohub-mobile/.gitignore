# Expo continuous native generation: android/ and ios/ come from app.json
/android/
/ios/
/.expo/
/dist/
/expo-env.d.ts
/web-build/

# Signing material stays on the build machine
credentials.json
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Generated by i18n:compile; a Turbo cache restore omits its own .gitignore.
/src/i18n/paraglide/

# Inlang writes its cache and metadata next to the settings when compiling;
# its self-written .gitignore is not always present (e.g. on a fresh compile).
/project.inlang/*
!/project.inlang/settings.json
