{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:web": {
      "dependsOn": ["^build", "i18n:compile"],
      "env": [
        "EXPO_PUBLIC_API_ORIGIN",
        "EXPO_PUBLIC_POSTHOG_KEY",
        "EXPO_PUBLIC_POSTHOG_HOST"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["i18n:compile"],
      "passThroughEnv": ["EXPO_PUBLIC_API_ORIGIN"]
    },
    "i18n:compile": {
      "inputs": [
        "messages/*.json",
        "project.inlang/settings.json",
        "package.json"
      ],
      "outputs": ["src/i18n/paraglide/**"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/lint/**"
      ]
    },
    "start": {
      "dependsOn": ["i18n:compile"],
      "passThroughEnv": ["EXPO_PUBLIC_API_ORIGIN"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/lint/**",
        "$TURBO_ROOT$/apps/deskohub-workspace/features/mobile-updates/code-signing-certificate.pem",
        "$TURBO_ROOT$/.github/workflows/mobile-release.yml"
      ],
      "dependsOn": ["$TURBO_EXTENDS$", "i18n:compile"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "i18n:compile"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    }
  }
}
