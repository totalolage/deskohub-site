#!/usr/bin/env bash
set -euo pipefail

issue_number="${1:?Usage: posthog-issue-open <issue-number>}"
[[ "$issue_number" =~ ^[1-9][0-9]*$ ]]
state="$("${GH_BIN:-gh}" issue view "$issue_number" --repo totalolage/deskohub-site --json state --jq .state)"
if [[ "$state" != OPEN ]]; then
  printf 'Refusing worker dispatch: issue #%s is not open.\n' "$issue_number" >&2
  exit 3
fi
