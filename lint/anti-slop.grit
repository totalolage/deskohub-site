engine biome(1.0)
language js(typescript, jsx)

// Existing debt is excluded per rule and file; remove exclusions as files are fixed.
// ponytail: direct syntax only; use Biome JS plugins when they expose scope/type APIs.
file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/(?:(?:app|db|emails|features|scripts|shared)/.*|[^/]+)\.(?:ts|tsx)$",
  $body <: contains bubble {
    or {
      or {
        `$value as $inner_type as $outer_type` as $outer_assertion,
        `($value as $inner_type) as $outer_type` as $outer_assertion,
        `<$outer_type><$inner_type>$value` as $outer_assertion,
        `<$outer_type>($value as $inner_type)` as $outer_assertion
      } where {
        not $filename <: r"(?s).*(?:\.test\.(?:ts|tsx)|features/checkout/reservation-quote-office\.ts)$",
        register_diagnostic(
          span = $outer_assertion,
          message = "[anti-slop/no-chained-type-assertions] Preserve the value's type evidence instead of chaining type assertions.",
          severity = "error"
        )
      },
      or {
        `{ ...($condition ? {} : $value) }` as $conditional_spread,
        `{ ...($condition ? $value : {}) }` as $conditional_spread
      } where {
        not $filename <: r".*features/checkout/backend/fulfillment/workspace-reservation-email\.service\.tsx$",
        register_diagnostic(
          span = $conditional_spread,
          message = "[anti-slop/no-conditional-empty-object-spread] Use a direct property or build the object in separate statements.",
          severity = "error"
        )
      },
      or {
        `$known as $broad` as $widening,
        `<$broad>$known` as $widening,
        `const $binding: $broad = $known` as $widening,
        `let $binding: $broad = $known` as $widening,
        `var $binding: $broad = $known` as $widening,
        `($parameters): $broad => $known` as $widening
      } where {
        not $filename <: r"(?s).*(?:\.test\.(?:ts|tsx)|features/administration/(?:admin-shell\.tsx|payment-administration\.service\.ts|reservation-date-range\.ts|reservation-lifecycle-map\.tsx)|features/checkout/(?:product-catalog\.i18n\.ts|product-catalog\.ts|workspace-room-layouts\.ts)|features/cookie-consent/(?:components/cookie-settings-page\.tsx|utils/posthog-url\.ts)|shared/backend/(?:analytics/posthog-event\.service\.ts|logging/censorship\.ts)|shared/(?:components/site-header-config\.ts|testing/workspace-component-module-mocks\.ts|utils/error-formatting\.ts))$",
        $broad <: r"(?s)^(?:unknown|object|Record\s*<[^>]+>|\{[^}]+\})$",
        $known <: or {
          JsObjectExpression(),
          JsArrayExpression(),
          JsArrowFunctionExpression(),
          JsClassExpression(),
          JsFunctionExpression(),
          JsNewExpression(),
          JsStringLiteralExpression(),
          JsNumberLiteralExpression(),
          JsBooleanLiteralExpression(),
          JsNullLiteralExpression(),
          JsTemplateExpression(),
          JsUnaryExpression()
        },
        register_diagnostic(
          span = $widening,
          message = "[anti-slop/no-known-value-widening] Preserve inference or use satisfies instead of widening a known value.",
          severity = "error"
        )
      },
      or {
        JsFormalParameter() as $object_parameter,
        JsRestParameter() as $object_parameter
      } where {
        $object_parameter <: r"(?s)^.*:\s*object(?:\s*=.*)?$",
        not $filename <: r".*(?:features/checkout/backend/checkout/checkout-session-key\.server\.ts|shared/utils/error-formatting\.ts)$",
        register_diagnostic(
          span = $object_parameter,
          message = "[anti-slop/no-object-parameters] Use the expected owner type instead of the broad object type.",
          severity = "error"
        )
      },
      JsUnaryExpression() as $runtime_typeof where {
        $runtime_typeof <: r"^typeof\b.*",
        not $filename <: r"(?s).*(?:app/api/workspace/availability/route\.ts|env\.ts|features/admin-cli/actions\.ts|features/administration/(?:page-data\.server\.ts|table-toolbar\.tsx)|features/checkout/(?:actions/apply-discount-code\.ts|backend/checkout/(?:pay-state|replacement-pay-state)\.test\.ts|backend/repositories/payment-lifecycle\.repository\.ts)|features/contact/actions/submit-contact\.ts|features/cookie-consent/(?:hooks/use-cookie-consent\.ts|utils/(?:consent-event|consent-mode|posthog-url)\.ts)|features/discounts/admin/(?:discount-administration\.service|form-feedback|form-input)\.ts|features/feature-flags/backend/node\.test\.ts|features/i18n/routing\.ts|features/legal/acceptance-snapshot\.ts|features/office/components/office-reservation-form\.tsx|features/reservation/(?:backend/workspace-availability-replacement\.test\.ts|components/(?:reservation-date-picker|reservation-date-time-picker)\.tsx)|shared/backend/(?:logging/(?:censorship\.ts|posthog-otel\.test\.ts)|observability/posthog-tracing\.test\.ts|workspace-action\.ts)|shared/utils/(?:consent-cookie|error-formatting|use-workspace-action)\.ts)$",
        register_diagnostic(
          span = $runtime_typeof,
          message = "[anti-slop/no-runtime-typeof] Parse external input at its I/O boundary instead of narrowing it with typeof.",
          severity = "error"
        )
      },
      or {
        JsIdentifierBinding() as $symbol,
        JsReferenceIdentifier() as $symbol,
        JsName() as $symbol,
        JsPrivateName() as $symbol,
        JsLiteralMemberName() as $symbol,
        TsIdentifierBinding() as $symbol,
        JsxName() as $symbol
      } where {
        $symbol <: r"(?i)^#?[A-Za-z_$][A-Za-z0-9_$]*shape[A-Za-z0-9_$]*$",
        not $filename <: r".*(?:features/checkout/components/workspace-table-map-view\.tsx|shared/backend/workspace-action\.ts|shared/utils/safe-action-client\.ts)$",
        register_diagnostic(
          span = $symbol,
          message = "[anti-slop/no-shape-in-symbol-names] Do not use shape in symbol names.",
          severity = "error"
        )
      },
      or {
        JsFormalParameter() as $unknown_parameter,
        JsRestParameter() as $unknown_parameter
      } where {
        $unknown_parameter <: r"(?s)^.*:\s*unknown(?:\s*=.*)?$",
        $unknown_parameter <: not r"^\s*(?:\.\.\.)?cause\??\s*:",
        not $filename <: r"(?s).*(?:app/api/(?:cron/workspace/reservation-holds|workspace/availability)/route\.ts|features/admin-cli/page-data\.server\.ts|features/administration/route-identifiers\.server\.ts|features/checkout/backend/(?:checkout/(?:advertised-price-state\.ts|checkout-session-key\.server\.test\.ts|checkout-state-token\.ts|checkout\.service\.ts|pay-state\.ts)|fulfillment/resend-webhook\.service\.ts|holds/(?:reservation-hold-cleanup-queue\.service(?:\.test)?\.ts|reservation-hold-cleanup\.service\.ts)|payment/(?:nexi-amount\.codec|nexi-webhook\.service)\.ts|repositories/payment-lifecycle\.repository\.ts)|features/contact/backend/contact\.service\.tsx|features/cowork/components/cowork-reservation-form\.test\.tsx|features/discounts/(?:admin/(?:basic-auth\.server\.test|discount-administration\.service|form-feedback)\.ts|contracts\.ts|discount-definition\.test\.ts|errors\.ts)|features/feature-flags/backend/node\.test\.ts|features/i18n/server/request-locale\.test\.ts|features/meeting-room/components/meeting-room-reservation-form\.test\.tsx|features/reservation/(?:actions/prepare-pay-state\.ts|reservation-interval-parser\.ts|reservation-interval\.ts|workspace-availability\.ts)|shared/backend/(?:logging/(?:censorship(?:\.test)?|database-query-logger)\.ts|workspace-action\.ts|workspace-route\.ts)|shared/testing/workspace-component-module-mocks\.ts|shared/utils/(?:consent-cookie|error-formatting|schema-parser|temporal|use-workspace-action)\.ts)$",
        register_diagnostic(
          span = $unknown_parameter,
          message = "[anti-slop/no-unknown-parameters] Parse the input into its expected owner type at the I/O boundary.",
          severity = "error"
        )
      },
      TsTypeAliasDeclaration() as $unknown_alias where {
        $unknown_alias <: r"(?s)^type\s+[A-Za-z_$][A-Za-z0-9_$]*\s*=\s*\(?\s*unknown\s*\)?\s*;?$",
        register_diagnostic(
          span = $unknown_alias,
          message = "[anti-slop/no-unknown-type-aliases] Keep unknown explicit at the boundary instead of hiding it behind an alias.",
          severity = "error"
        )
      },
      or {
        TsReferenceType() as $unsafe_dictionary,
        TsIndexSignatureTypeMember() as $unsafe_dictionary,
        TsIndexSignatureClassMember() as $unsafe_dictionary,
        TsMappedType() as $unsafe_dictionary
      } where {
        $unsafe_dictionary <: or {
          r"(?s)^Record\s*<.*,\s*.*(?:unknown|any|object|\{\}).*>$",
          r"(?s).*\]\s*:\s*.*(?:unknown|any|object|\{\}).*"
        },
        not $filename <: r"(?s).*(?:features/checkout/backend/checkout/(?:checkout-status\.service\.test|checkout\.service\.test|pay-state\.test)\.ts|features/cookie-consent/utils/(?:posthog-event\.test|posthog-url)\.ts|features/discounts/(?:discount-release-gate\.service\.test|discount\.service\.test|provider)\.ts|features/i18n/server/route-params\.ts|features/landing-page/landing-page-sale-banner\.server\.test\.ts|shared/backend/(?:analytics/posthog-event\.service\.ts|logging/censorship(?:\.test)?\.ts))$",
        register_diagnostic(
          span = $unsafe_dictionary,
          message = "[anti-slop/no-unsafe-dictionary-type] Use a concrete owner/schema-derived dictionary value type.",
          severity = "error"
        )
      },
      `$binding as $target` as $widen_then_assert where {
        $program <: contains or {
          `const $binding: $broad = $known`,
          `const $binding = $known as $broad`
        },
        $broad <: or {
          TsUnknownType(),
          TsAnyType(),
          TsNonPrimitiveType(),
          r"^Record\s*<.*,\s*(?:unknown|any)>$"
        },
        $known <: or {
          JsObjectExpression(),
          JsArrayExpression(),
          JsArrowFunctionExpression(),
          JsClassExpression(),
          JsFunctionExpression(),
          JsNewExpression(),
          JsStringLiteralExpression(),
          JsNumberLiteralExpression(),
          JsBooleanLiteralExpression(),
          JsNullLiteralExpression(),
          JsTemplateExpression(),
          JsUnaryExpression()
        },
        $target <: not or {
          TsUnknownType(),
          TsAnyType(),
          TsNonPrimitiveType(),
          r"^Record\s*<.*,\s*(?:unknown|any)>$"
        },
        register_diagnostic(
          span = $widen_then_assert,
          message = "[anti-slop/no-widen-then-assert] Preserve the precise type instead of widening and reconstructing it with an assertion.",
          severity = "error"
        )
      }
    }
  }
}
