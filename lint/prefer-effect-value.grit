engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/.*\.(?:ts|tsx)$",
  not $name <: r".*\.(?:test|test-utils)\.(?:ts|tsx)$",
  not $name <: r".*/generated/.*",
  $body <: contains bubble {
    `Effect.fn($trace)($callback)` as $wrapper where {
      $callback <: r"(?s)^\s*\(\s*\)\s*=>\s*Effect\.(?:tryPromise|promise|sync|try|suspend)\s*\(.*\)\s*(?:\.pipe\s*\(.*\))?\s*$",
      register_diagnostic(
        span = $wrapper,
        message = "Define a lazy Effect value and preserve its trace with Effect.withSpan.",
        severity = "error"
      )
    }
  }
}
