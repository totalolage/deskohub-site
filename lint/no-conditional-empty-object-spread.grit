engine biome(1.0)
language js(typescript, jsx)

// ponytail: direct syntax only; use Biome JS plugins when they expose scope/type APIs.
file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/(?:(?:app|db|emails|features|scripts|shared)/.*|[^/]+)\.(?:ts|tsx)$",
  $body <: contains bubble {
    or {
      `...($condition ? {} : $value)` as $conditional_spread,
      `...($condition ? $value : {})` as $conditional_spread
    } where {
      register_diagnostic(
        span = $conditional_spread,
        message = "[anti-slop/no-conditional-empty-object-spread] Use a direct property or build the object in separate statements.",
        severity = "error"
      )
    }
  }
}
