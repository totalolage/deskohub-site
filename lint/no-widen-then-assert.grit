engine biome(1.0)
language js(typescript, jsx)

// ponytail: direct syntax only; use Biome JS plugins when they expose scope/type APIs.
file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/(?:(?:app|db|emails|features|scripts|shared)/.*|[^/]+)\.(?:ts|tsx)$",
  $body <: contains bubble {
    `$binding as $target` as $widen_then_assert where {
      or {
        and {
          $widen_then_assert <: within (or {
            JsFunctionBody(),
            JsBlockStatement()
          } as $boundary),
          $boundary <: contains or {
            `const $binding: $broad = $known`,
            `const $binding = $known as $broad`
          },
          not $boundary <: contains (or {
            JsFunctionBody(),
            JsBlockStatement()
          } as $nested_boundary) where {
            $nested_boundary <: not $boundary,
            $nested_boundary <: contains or {
              `const $binding: $_ = $_`,
              `const $binding = $_ as $_`
            }
          }
        },
        and {
          $widen_then_assert <: not within or {
            JsFunctionBody(),
            JsBlockStatement()
          },
          $program <: contains (or {
            `const $binding: $broad = $known`,
            `const $binding = $known as $broad`
          } as $declaration),
          $declaration <: not within or {
            JsFunctionBody(),
            JsBlockStatement()
          }
        }
      },
      $broad <: or {
        TsUnknownType(),
        TsAnyType(),
        TsNonPrimitiveType(),
        r"^Record\s*<.*,\s*(?:unknown|any)>$"
      },
      $known <: or {
        JsObjectExpression(),
        JsArrayExpression(),
        JsArrowFunctionExpression(),
        JsClassExpression(),
        JsFunctionExpression(),
        JsNewExpression(),
        JsStringLiteralExpression(),
        JsNumberLiteralExpression(),
        JsBooleanLiteralExpression(),
        JsNullLiteralExpression(),
        JsTemplateExpression(),
        JsUnaryExpression()
      },
      $target <: not or {
        TsUnknownType(),
        TsAnyType(),
        TsNonPrimitiveType(),
        r"^Record\s*<.*,\s*(?:unknown|any)>$"
      },
      register_diagnostic(
        span = $widen_then_assert,
        message = "[anti-slop/no-widen-then-assert] Preserve the precise type instead of widening and reconstructing it with an assertion.",
        severity = "error"
      )
    }
  }
}
