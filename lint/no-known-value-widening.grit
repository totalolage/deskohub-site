engine biome(1.0)
language js(typescript, jsx)

// Existing debt is excluded per file; remove exclusions as files are fixed.
// ponytail: direct syntax only; use Biome JS plugins when they expose scope/type APIs.
file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/(?:(?:app|db|emails|features|scripts|shared)/.*|[^/]+)\.(?:ts|tsx)$",
  $body <: contains bubble {
    or {
      `$known as $broad` as $widening,
      `<$broad>$known` as $widening,
      `const $binding: $broad = $known` as $widening,
      `let $binding: $broad = $known` as $widening,
      `var $binding: $broad = $known` as $widening,
      `($parameters): $broad => $known` as $widening
    } where {
      not $filename <: r"(?s).*(?:\.test\.(?:ts|tsx)|features/administration/(?:admin-shell\.tsx|payment-administration\.service\.ts|reservation-date-range\.ts|reservation-lifecycle-map\.tsx)|features/checkout/(?:product-catalog\.i18n\.ts|product-catalog\.ts|workspace-room-layouts\.ts)|features/cookie-consent/(?:components/cookie-settings-page\.tsx|utils/posthog-url\.ts)|features/legal/content\.tsx|shared/backend/(?:analytics/posthog-event\.service\.ts|logging/censorship\.ts)|shared/(?:components/site-header-config\.ts|testing/workspace-component-module-mocks\.ts|utils/error-formatting\.ts))$",
      or {
        $broad <: r"(?s)^(?:unknown|object|\{[^}]+\})$",
        and {
          $broad <: r"(?s)^Record\s*<.*>$",
          not $known <: `{}`
        }
      },
      $known <: or {
        JsObjectExpression(),
        JsArrayExpression(),
        JsArrowFunctionExpression(),
        JsClassExpression(),
        JsFunctionExpression(),
        JsNewExpression(),
        JsStringLiteralExpression(),
        JsNumberLiteralExpression(),
        JsBooleanLiteralExpression(),
        JsNullLiteralExpression(),
        JsTemplateExpression(),
        JsUnaryExpression()
      },
      register_diagnostic(
        span = $widening,
        message = "[anti-slop/no-known-value-widening] Preserve inference or use satisfies instead of widening a known value.",
        severity = "error"
      )
    }
  }
}
