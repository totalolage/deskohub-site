engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  or {
    and {
      $name <: r".*apps/deskohub-workspace/features/checkout/backend/analytics/.*\.(?:ts|tsx)$",
      $body <: contains bubble {
        `$parameters => Effect.gen(function* ($generator_parameters) { $statements })` as $wrapper where {
          register_diagnostic(
            span = $wrapper,
            message = "Define Effect generator functions with Effect.fn instead of wrapping Effect.gen in an arrow function.",
            severity = "error"
          )
        }
      }
    },
    and {
      $name <: r".*apps/deskohub-workspace/.*\.(?:ts|tsx)$",
      not $name <: r".*\.(?:test|test-utils)\.(?:ts|tsx)$",
      not $name <: r".*/generated/.*",
      not $name <: r".*apps/deskohub-workspace/features/checkout/backend/analytics/.*",
      $body <: contains bubble {
        `Effect.fn($trace)($args)` as $wrapper where {
          $args <: r"(?s)^\s*\((?:[^()]|\((?:[^()]|\([^()]*\))*\))*\)\s*=>\s*Effect\.gen\(function\*.*",
          register_diagnostic(
            span = $wrapper,
            message = "Effect.fn already traces its callback; declare the generator function directly instead of returning Effect.gen from an arrow function.",
            severity = "error"
          )
        }
      }
    }
  }
}
