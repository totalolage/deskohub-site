engine biome(1.0)
language js(typescript, jsx)

file($name, $body) where {
  $name <: r".*apps/deskohub-workspace/.*\.(?:ts|tsx)$",
  $body <: contains bubble {
    or {
      `$_.spawnSync($...)` as $use,
      `$_.execSync($...)` as $use,
      `$_.execFileSync($...)` as $use,
      `spawnSync($...)` as $use,
      `execSync($...)` as $use,
      `execFileSync($...)` as $use
    } where {
      register_diagnostic(
        span = $use,
        message = "Run subprocesses with runCommand or commandOutput from scripts/shared/command; Bun 1.4.2 synchronous spawns can hang bun test workers.",
        severity = "error"
      )
    }
  }
}
